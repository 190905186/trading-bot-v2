# Redis
TB2_REDIS_URL=redis://127.0.0.1:6381/0

# SQLite (ticks + candles from all brokers)
TB2_SQLITE_PATH=data/trading_bot_v2.db

# Dashboard
TB2_DASHBOARD_STREAM_READ_MAX=50000

# Market data (one broker per tick process)
TB2_MARKET_DATA_SOURCE=zerodha
TB2_BROKER_NAME=zerodha

# Token universe (generate with scripts/generate_token_universe.py + build_token_batches.py)
TB2_TOKEN_UNIVERSE_DIR=data/token_universe
TB2_BATCH_PROFILE=production

# One batch per tick process (production: 9 processes via run_ticks_sessions.py)
TB2_TICK_BATCH=batch1
TB2_TICK_SESSION_ID=batch1
TB2_SERVICE_NAME=ticks-zerodha-batch1
TB2_ZERODHA_MAX_TOKENS_PER_SESSION=3000

# Launch all sessions: zerodha:batch1,zerodha:batch2,... (see scripts/run_ticks_sessions.py)
# TB2_TICK_SESSIONS=zerodha:batch1,zerodha:batch2,zerodha:batch3,angelone:batch4,angelone:batch5,angelone:batch6,finvasia:batch7,finvasia:batch8,finvasia:batch9

# Dev fallback (when TB2_TICK_BATCH is unset)
# TB2_INSTRUMENTS=256265,738561,2953217

# Zerodha
TB2_ZERODHA_API_KEY=
TB2_ZERODHA_ACCESS_TOKEN=
TB2_ZERODHA_HISTORICAL_CONTINUOUS=0
# Kite instruments cache for exchange_token -> instrument_token mapping (refreshed daily)
TB2_ZERODHA_INSTRUMENTS_CSV=data/instruments.csv

# Historical candles
TB2_HIST_MODE=one-shot
TB2_HIST_DATE=
TB2_HIST_BATCHES=batch1
